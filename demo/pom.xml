<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.laeubi</groupId>
        <artifactId>osgi-jdk-server-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>osgi-jdk-server-demo</artifactId>
    <packaging>jar</packaging>

    <name>OSGi JDK HttpServer Whiteboard (Demo)</name>
    <description>Demo module showcasing use-cases of the OSGi JDK HttpServer Whiteboard Specification</description>

    <dependencies>
        <!-- runtime module providing the whiteboard specification and implementation -->
        <dependency>
            <groupId>org.laeubi</groupId>
            <artifactId>osgi-jdk-server</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- OSGi Core API (spec interfaces and ServiceTracker) -->
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.core</artifactId>
            <version>8.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Declarative Services component property type annotations -->
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
            <version>1.5.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- Declarative Services runtime API, used for ComponentConstants
             (matches org.apache.felix.hc.core.impl.servlet.ResultHtmlSerializer) -->
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component</artifactId>
            <version>1.5.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- OSGi metatype annotations, used for the @ObjectClassDefinition
             configuration descriptions of the health check demo -->
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.metatype.annotations</artifactId>
            <version>1.4.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- Apache Felix Health Check API - the health-check-jdk demo
             re-exposes the existing HealthCheckExecutor service (and its
             Result / HealthCheckExecutionResult DTOs) via a JDK HttpServer
             HttpHandler instead of the original Servlet -->
        <dependency>
            <groupId>org.apache.felix</groupId>
            <artifactId>org.apache.felix.healthcheck.api</artifactId>
            <version>2.0.4</version>
            <scope>provided</scope>
        </dependency>

        <!-- Used for JSONWriter, matching the original org.apache.felix.hc.core.impl.servlet.ResultJsonSerializer -->
        <dependency>
            <groupId>org.apache.felix</groupId>
            <artifactId>org.apache.felix.utils</artifactId>
            <version>1.11.8</version>
            <scope>provided</scope>
        </dependency>

        <!-- SLF4J API used for logging, as in the original Felix Health Check servlet -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.13</version>
            <scope>provided</scope>
        </dependency>

        <!-- Apache Felix OSGi framework - used in tests as embedded runtime -->
        <dependency>
            <groupId>org.apache.felix</groupId>
            <artifactId>org.apache.felix.framework</artifactId>
            <version>7.0.5</version>
            <scope>test</scope>
        </dependency>

        <!-- Apache Felix Health Check Executor implementation - used in tests
             to run the demo end-to-end against a real HealthCheckExecutor -->
        <dependency>
            <groupId>org.apache.felix</groupId>
            <artifactId>org.apache.felix.healthcheck.core</artifactId>
            <version>2.3.0</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>

        <!-- Simple slf4j binding so log output is visible during tests -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
